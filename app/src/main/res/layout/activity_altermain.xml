<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".AlterMainActivity">

    <ImageButton
        android:id="@+id/change"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/ui_change"
        android:src="@drawable/ic_oui_back_and_forth"
        android:background="?listChoiceBackgroundIndicator"
        android:layout_gravity="start"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/refresh"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/ui_refresh"
        android:src="@drawable/ic_oui_refresh"
        android:background="?listChoiceBackgroundIndicator"
        android:layout_gravity="end"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:gravity="center"
            android:text="@string/app_name_digitallegacy"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/ui_legacy_create"/>

            <Button
                android:id="@+id/guest_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/ui_legacy_start"/>

            <Button
                android:id="@+id/guest_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/ui_legacy_exit"/>

            <Button
                android:id="@+id/guest_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/ui_legacy_end"/>

            <Button
                android:id="@+id/guest_destroy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/ui_legacy_destroy"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>